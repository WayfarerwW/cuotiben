# 错题本 · 环境变量模板
#
# 用法：复制成 .env 再按需修改。**不要把 .env 提交到 Git**
# （.gitignore 已忽略 .env 与 .env.*，只有本模板 .env.example 入库）。
#
#     cp .env.example .env
#
# .env 在应用启动时由 app/main.py 读取（python-dotenv）。
# 注意：**真实环境变量优先于 .env**，方便临时覆盖而不改文件。

# ---------------------------------------------------------------------------
# GitHub 自动同步（AGENTS.md 第五节）
# ---------------------------------------------------------------------------
# 默认关闭。只有把 GIT_SYNC_ENABLED 设为 1 才会启动后台同步线程。
GIT_SYNC_ENABLED=0

# 目标仓库地址。**不要**把 token 写进这个 URL ——
# 那会以明文留在 .git/config 里。token 走下面的 GIT_SYNC_TOKEN，
# 推送时通过 GIT_ASKPASS 临时注入，不落盘。
GIT_SYNC_REPO_URL=https://github.com/<你的用户名>/<仓库名>.git

# GitHub Personal Access Token（需要 repo 写权限）。留空则不发送凭据。
GIT_SYNC_TOKEN=

# 后台线程每隔多少分钟检查一次变更。正整数，默认 10。
GIT_SYNC_INTERVAL_MINUTES=10

# 推送到哪个分支。默认 main。
GIT_SYNC_BRANCH=main

# 自动提交使用的 git 身份。用 -c 临时传入，不写进 .git/config。
GIT_SYNC_AUTHOR_NAME=cuotiben-sync
GIT_SYNC_AUTHOR_EMAIL=cuotiben-sync@localhost

# ---------------------------------------------------------------------------
# 可选：其它环境变量
# ---------------------------------------------------------------------------
# 数据库连接串（默认 data/cuotiben.db）。
# CUOTIBEN_DATABASE_URL=sqlite:///D:/somewhere/cuotiben.db

# "今日"的时区（默认 Asia/Shanghai）。
# CUOTIBEN_TIMEZONE=Asia/Shanghai

# 备份 / 图片目录（默认项目下的 backups/ 与 uploads/）。
# CUOTIBEN_BACKUPS_DIR=D:/cuotiben-backups
# CUOTIBEN_UPLOADS_DIR=D:/cuotiben-uploads
